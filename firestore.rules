rules_version = '2';

// =====================================================================
//  กฎความปลอดภัย Firestore สำหรับห้องเรียนออนไลน์
//  ★ แก้อีเมลผู้ดูแลระบบในฟังก์ชัน isAdmin() ให้ตรงกับบัญชีจริง ★
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ★ ผู้ดูแลระบบ (admin) 3-4 คน: ดาวน์โหลดคะแนน ส่งคะแนนเข้า ITW51 จัดการภาคเรียน สร้างบัญชีครู
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['admin@example.com'];
    }
    // ครูผู้สอน: มีบัญชีใน staff ที่ผู้ดูแลสร้าง และยังเปิดใช้งาน
    function isTeacher() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'teacher'
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true;
    }
    function isStaff() { return isAdmin() || isTeacher(); }

    // การตั้งค่าทั่วไป (ภาคเรียนปัจจุบัน) — ทุกคนอ่านได้
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // เนื้อหาบทเรียน (ไม่มีเฉลย) — ทุกคนอ่านได้ · ครูและผู้ดูแลเพิ่ม/แก้ไขได้
    match /courses/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    // เฉลย และรายชื่อนักศึกษาทั้งหมด — ผู้ดูแลเท่านั้น
    match /keys/{id} {
      allow read, write: if isStaff();
    }
    // รายชื่อนักศึกษา/รายวิชาของแต่ละภาคเรียน — ครูอ่านได้ (หน้าเว็บแสดงเฉพาะกลุ่มของครู) · ผู้ดูแลแก้ไข
    match /admin/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    // บัญชีครู: ผู้ดูแลจัดการ · ครูอ่านข้อมูลตนเองได้
    match /staff/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin();
      // ครูบันทึกได้เฉพาะว่า "เปลี่ยนรหัสผ่านแล้ว" (ใช้ซ่อนปุ่ม เปลี่ยนได้ 1 ครั้ง)
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pwChanged', 'pwChangedAt'])
        && request.resource.data.pwChanged == true;
    }
    // ค้นอีเมลเข้าระบบจากชื่อครู (รหัสเอกสาร = SHA-256 ของชื่อ)
    match /teacherLogin/{key} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // บัญชีนักศึกษา: รหัสเอกสาร = SHA-256(รหัสนักศึกษา + เลขบัตร)
    // อ่านได้เฉพาะเมื่อรู้รหัสเอกสาร (get) ห้ามดึงรายชื่อทั้งหมด (list)
    match /logins/{key} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // ผลการเรียนของนักศึกษา: รหัสเอกสาร = {key}__{courseId}
    match /results/{rid} {
      function loginKey() { return rid.split('__')[0]; }
      function cid() { return rid.split('__')[1]; }
      function loginPath() { return /databases/$(database)/documents/logins/$(loginKey()); }
      function enrolled() {
        return rid.split('__').size() == 2
          && exists(loginPath())
          && get(loginPath()).data.courses.hasAny([cid()]);
      }
      function studentFields() {
        return ['sid', 'courseId', 'sem', 'video', 'videoDone', 'articleAt', 'quiz', 'quizAt', 'updatedAt', 'vc', 'qc'];
      }
      function identityOk(d) {
        return d.sid == get(loginPath()).data.sid && d.courseId == cid();
      }
      // ตรวจคะแนนทันที: นักศึกษาบันทึกจำนวนข้อถูก (vc/qc) ได้ไม่เกินจำนวนที่ถูกจริงตามเฉลย
      // (เฉลยอ่านได้เฉพาะในกฎนี้ นักศึกษาไม่เห็นเฉลย) และทำได้เมื่อคำตอบถูกล็อกแล้วเท่านั้น
      function keyData() { return get(/databases/$(database)/documents/keys/$(cid())).data; }
      function countsOk(d) {
        return (!('vc' in d) || (d.vc is int && d.vc >= 0
                  && d.vc <= d.video.diff(keyData().video).unchangedKeys().size()))
          && (!('qc' in d) || (d.qc is int && d.qc >= 0 && 'quizAt' in d
                  && d.qc <= d.quiz.diff(keyData().quiz).unchangedKeys().size()));
      }
      // ส่งแบบทดสอบได้ครั้งเดียว
      function quizOkCreate(d) {
        return !('quiz' in d) || d.quizAt == request.time;
      }
      function quizOkUpdate(d, old) {
        return !d.diff(old).affectedKeys().hasAny(['quiz', 'quizAt'])
          || (!('quizAt' in old) && d.quizAt == request.time);
      }
      // คำตอบวิดีโอที่ตอบไปแล้วแก้ไม่ได้ (เพิ่มได้อย่างเดียว)
      function videoOkUpdate(d, old) {
        return !('video' in old)
          || ('video' in d
              && d.video.diff(old.video).changedKeys().size() == 0
              && d.video.diff(old.video).removedKeys().size() == 0);
      }

      allow get: if true;
      allow list: if isStaff();
      allow delete: if isAdmin();
      allow create: if isAdmin() || (
        enrolled()
        && request.resource.data.keys().hasOnly(studentFields())
        && identityOk(request.resource.data)
        && quizOkCreate(request.resource.data)
        && countsOk(request.resource.data)
      );
      allow update: if isStaff() || (
        enrolled()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(studentFields())
        && identityOk(request.resource.data)
        && quizOkUpdate(request.resource.data, resource.data)
        && videoOkUpdate(request.resource.data, resource.data)
        && countsOk(request.resource.data)
      );
    }
  }
}
